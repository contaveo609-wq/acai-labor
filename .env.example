# Açaí Labor é o padrão; defina false apenas para abrir o código legado.
VITE_DEMO_MODE=true
# Tráfego pago (somente servidor; não reutilizar token WhatsApp):
# META_ADS_API_VERSION=vXX.0
# META_ADS_APP_ID=
# META_ADS_APP_SECRET=
# META_ADS_REDIRECT_URI=https://seu-dominio.example/api/meta-ads/callback
# META_ADS_PIXEL_ID=
# META_ADS_CAPI_TOKEN=
# Açaí Labor local: pagamentos de demonstração. WhatsApp oficial é configurado no painel.
# LABOR_STORE_ID=acai-labor
# DEMO_DATA_DIR=.local/labor
# Produção: aplicar as migrations de 20261028 (base da loja e sessões do admin)
# no projeto Supabase e configurar as variáveis abaixo no servidor.
# Nunca coloque a service role key em variáveis VITE_*.
# LABOR_STORAGE=supabase
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Lovable reserva SUPABASE_*. Use estes nomes ao conectar um Supabase externo lá:
# LABOR_SUPABASE_URL=https://seu-projeto.supabase.co
# LABOR_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# LABOR_ADMIN_SETUP_TOKEN=gere-um-segredo-longo-para-a-primeira-senha
# LABOR_SESSION_SECRET=gere-outro-segredo-longo-para-as-sessoes
# LOVABLE_DB_MIGRATION_URL=postgresql://postgres:[senha]@db.[projeto].supabase.co:5432/postgres
# Uma pasta e um processo por estabelecimento. Veja docs/WHATSAPP-E-OPERACAO.md.
# Para hospedar um único servidor Node persistente, veja docs/PUBLICACAO-ACAI-LABOR.md.
# Opcional no ambiente do processo do servidor, nunca com prefixo VITE_:
# GEMINI_API_KEY=
# Alternativa: guardar a chave pela página Inteligência Artificial (Windows DPAPI).
# Em sistemas sem Windows, o cofre exige uma chave externa de 32 bytes em base64:
# LABOR_SECRET_KEY=
# Produção, somente no ambiente do servidor (sem prefixo VITE_):
# LABOR_PUBLIC_BASE_URL=https://seu-dominio.example
# LABOR_ENCRYPT_DATA=1  # apenas para modo local
# LABOR_VAPID_SUBJECT=mailto:contato@seu-dominio.example
