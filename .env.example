VITE_DEMO_MODE=true
# Açaí Labor local: pagamentos de demonstração. WhatsApp oficial é configurado no painel.
# LABOR_STORE_ID=acai-labor
# DEMO_DATA_DIR=.local/labor
# Uma pasta e um processo por estabelecimento. Veja docs/WHATSAPP-E-OPERACAO.md.
# Para hospedar um único servidor Node persistente, veja docs/PUBLICACAO-ACAI-LABOR.md.
# Opcional no ambiente do processo do servidor, nunca com prefixo VITE_:
# GEMINI_API_KEY=
# Alternativa: guardar a chave pela página Inteligência Artificial (Windows DPAPI).
# Em sistemas sem Windows, o cofre exige uma chave externa de 32 bytes em base64:
# LABOR_SECRET_KEY=
# Produção, somente no ambiente do servidor (sem prefixo VITE_):
# LABOR_PUBLIC_BASE_URL=https://seu-dominio.example
# LABOR_ENCRYPT_DATA=1
# LABOR_VAPID_SUBJECT=mailto:contato@seu-dominio.example
